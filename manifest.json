{
  "manifest_version": 3,
  "name": "Mind Console",
  "version": "1.0.0",
  "description": "Side panel for venice.ai Minds: detects the Mind and shows its control console. Built-in profiles plus your own via JSON. Unofficial.",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://venice.ai/*",
    "https://*.venice.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Mind Console",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://venice.ai/*",
        "https://*.venice.ai/*"
      ],
      "js": [
        "profiles/registry.js",
        "profiles/nightingale.js",
        "profiles/ghostline.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "homepage_url": "https://github.com/dwh1611/venicemindcontrol"
}
